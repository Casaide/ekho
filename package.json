{
  "name": "ekho",
  "version": "0.1.0",
  "private": true,
  "description": "Off-grid messenger: LoRa first through a Meshtastic radio, IRC when no nodes are heard",
  "type": "module",
  "exports": {
    "./package": "./package.json",
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "app.ts",
    "lib"
  ],
  "scripts": {
    "start": "bare-build --out build --runtime bare-native/runtime app.ts",
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "typecheck": "tsc --noEmit",
    "test": "bare-native-test test.ts --out test/native"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casaide/ekho.git"
  },
  "author": "Dominic Cassidy",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Casaide/ekho/issues"
  },
  "homepage": "https://github.com/Casaide/ekho#readme",
  "dependencies": {
    "b4a": "^1.9.0",
    "bare-bluetooth": "^0.6.8",
    "bare-events": "^2.9.2",
    "bare-fetch": "^3.5.0",
    "bare-foreground-service-android": "file:packages/bare-foreground-service-android",
    "bare-fs": "^4.8.7",
    "bare-logger": "^2.0.6",
    "bare-meshtastic": "^0.0.1",
    "bare-native": "^0.3.8",
    "bare-navigation-android": "^0.1.1",
    "bare-notifications-android": "file:packages/bare-notifications-android",
    "bare-notifications-darwin": "file:packages/bare-notifications-darwin",
    "bare-open-url-android": "file:packages/bare-open-url-android",
    "bare-open-url-darwin": "file:packages/bare-open-url-darwin",
    "bare-os": "^3.9.4",
    "bare-path": "^3.1.3",
    "bare-tls": "^4.2.0",
    "blind-pairing": "^2.3.1",
    "corestore": "^7.16.1",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.2"
  },
  "devDependencies": {
    "bare-build": "^1.7.0",
    "bare-native-test": "^0.1.8",
    "bare-tap": "^1.1.0",
    "hyperdht": "^6.37.0",
    "lunte": "^1.8.6",
    "prettier": "^3.10.1",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
