<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Dark from the first frame. The boot screen is Android's own: the icon
       on the ground colour while the app starts. -->
  <style name="Ekho" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/ground</item>
    <item name="android:statusBarColor">@color/ground</item>
    <item name="android:navigationBarColor">@color/ground</item>
    <item name="android:windowSplashScreenBackground">@color/ground</item>
    <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
  </style>
</resources>
